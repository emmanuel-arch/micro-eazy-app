# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local development. Vite only exposes VITE_-prefixed keys to
# the browser bundle, so nothing secret can go in this file — everything here
# ships to the handset in plain text.
# ─────────────────────────────────────────────────────────────────────────────

# Which lender's book this app stands in. Sent as `lenderSlug` on every
# /api/portal/* call (see src/lib/api/portal.ts). One build, many lenders.
VITE_LENDER_SLUG=micromart

# The SECOND road to the suite — a Tailscale Funnel host, publicly reachable, so
# a customer on a phone does not need the tailnet. Leave EMPTY to run on the
# primary alone; setting it arms failover in src/lib/net/transport.ts.
#
# Read that file before setting this. A fallback is a different origin, so the
# SameSite=Lax session cookie does NOT travel to it: today it carries public
# calls only, and authenticated calls are reported degraded rather than sent and
# silently failed. Arming it does not make the app more available to a
# signed-in customer until the suite issues a bearer token from
# /api/portal/otp/verify.
VITE_API_FALLBACK=

# Dev only. Where `vite dev` proxies /api. Production never reads this — the
# proxy is vercel.json's rewrite, at the edge, so the cookie stays same-origin.
VITE_SUITE_ORIGIN=https://lms.servicesuitecloud.com
